# Copy this file to .env for local testing. On GitHub, set these as Actions secrets instead.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Who receives the digests (comma-separated for multiple). Defaults to GMAIL_ADDRESS if unset.
RECIPIENT_EMAIL=you@gmail.com
# Optional: link to the dashboard shown in emails
DASHBOARD_URL=
